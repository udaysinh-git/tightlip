{
  "name": "tightlip-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && npm run wasm:mock && vite",
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:mock": "node scripts/build-wasm-mock.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run wasm && vite build && node scripts/release.mjs",
    "test:e2e": "npm run build && npm run wasm:mock && playwright test"
  },
  "dependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@playwright/test": "1.65.1",
    "@solidjs/babel-plugin": "2.0.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
